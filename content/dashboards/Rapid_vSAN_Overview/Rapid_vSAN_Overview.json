       "value": "o%3Acolumns%3Da%253Ao%25253Aid%25253Ds%2525253ApermTableView_widget_fdd500d8-cdf3-48e1-976d-5715b6b73700_6a19d00b-a089-443c-9f7a-02bef0d26aef-column-0%25255Ehidden%25253Db%2525253A0%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_fdd500d8-cdf3-48e1-976d-5715b6b73700_6a19d00b-a089-443c-9f7a-02bef0d26aef-column-avgLatency1%25255Ehidden%25253Db%2525253A0%25255Ewidth%25253Dn%2525253A115%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_fdd500d8-cdf3-48e1-976d-5715b6b73700_6a19d00b-a089-443c-9f7a-02bef0d26aef-column-maxLatency2%25255Ehidden%25253Db%2525253A0%25255Ewidth%25253Dn%2525253A109%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_fdd500d8-cdf3-48e1-976d-5715b6b73700_6a19d00b-a089-443c-9f7a-02bef0d26aef-column-txQLatAvg3%25255Ehidden%25253Db%2525253A0%25255Ewidth%25253Dn%2525253A136%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_fdd500d8-cdf3-48e1-976d-5715b6b73700_6a19d00b-a089-443c-9f7a-02bef0d26aef-column-txQLatMax4%25255Ehidden%25253Db%2525253A0%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_fdd500d8-cdf3-48e1-976d-5715b6b73700_6a19d00b-a089-443c-9f7a-02bef0d26aef-column-txSbSpaceMin5%25255Ehidden%25253Db%2525253A0%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_fdd500d8-cdf3-48e1-976d-5715b6b73700_6a19d00b-a089-443c-9f7a-02bef0d26aef-column-rxSbSpaceMin6%25255Ehidden%25253Db%2525253A0%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_fdd500d8-cdf3-48e1-976d-5715b6b73700_6a19d00b-a089-443c-9f7a-02bef0d26aef-column-kaReset7%25255Ehidden%25253Db%2525253A0%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_fdd500d8-cdf3-48e1-976d-5715b6b73700_6a19d00b-a089-443c-9f7a-02bef0d26aef-column-numReadyDelay8%25255Ehidden%25253Db%2525253A0",
