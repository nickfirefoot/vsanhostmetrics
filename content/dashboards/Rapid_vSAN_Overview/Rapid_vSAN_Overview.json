       "value": "o%3Acolumns%3Da%253Ao%25253Aid%25253Ds%2525253ApermTableView_widget_fa578b63-94e2-441c-8dd2-11fd4ca2d063_fefa8db6-5e2d-4905-9d11-2f5e279ea264-column-0%25255Ehidden%25253Db%2525253A0%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_fa578b63-94e2-441c-8dd2-11fd4ca2d063_fefa8db6-5e2d-4905-9d11-2f5e279ea264-column-avgLatency1%25255Ehidden%25253Db%2525253A0%25255Ewidth%25253Dn%2525253A115%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_fa578b63-94e2-441c-8dd2-11fd4ca2d063_fefa8db6-5e2d-4905-9d11-2f5e279ea264-column-maxLatency2%25255Ehidden%25253Db%2525253A0%25255Ewidth%25253Dn%2525253A109%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_fa578b63-94e2-441c-8dd2-11fd4ca2d063_fefa8db6-5e2d-4905-9d11-2f5e279ea264-column-txQLatAvg3%25255Ehidden%25253Db%2525253A0%25255Ewidth%25253Dn%2525253A136%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_fa578b63-94e2-441c-8dd2-11fd4ca2d063_fefa8db6-5e2d-4905-9d11-2f5e279ea264-column-txQLatMax4%25255Ehidden%25253Db%2525253A0%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_fa578b63-94e2-441c-8dd2-11fd4ca2d063_fefa8db6-5e2d-4905-9d11-2f5e279ea264-column-txSbSpaceMin5%25255Ehidden%25253Db%2525253A0%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_fa578b63-94e2-441c-8dd2-11fd4ca2d063_fefa8db6-5e2d-4905-9d11-2f5e279ea264-column-rxSbSpaceMin6%25255Ehidden%25253Db%2525253A0%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_fa578b63-94e2-441c-8dd2-11fd4ca2d063_fefa8db6-5e2d-4905-9d11-2f5e279ea264-column-kaReset7%25255Ehidden%25253Db%2525253A0%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_fa578b63-94e2-441c-8dd2-11fd4ca2d063_fefa8db6-5e2d-4905-9d11-2f5e279ea264-column-numReadyDelay8%25255Ehidden%25253Db%2525253A0",
