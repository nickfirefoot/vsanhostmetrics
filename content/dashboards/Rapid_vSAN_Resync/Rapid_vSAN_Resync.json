       "value": "o%3Acolumns%3Da%253Ao%25253Aid%25253Ds%2525253ApermTableView_widget_051612ce-6c04-407a-bac9-523b04f4e0f1_d93278f6-9623-4389-bdfa-4dc1836e9797-column-0%25255Ehidden%25253Db%2525253A0%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_051612ce-6c04-407a-bac9-523b04f4e0f1_d93278f6-9623-4389-bdfa-4dc1836e9797-column-avgLatency1%25255Ehidden%25253Db%2525253A0%25255Ewidth%25253Dn%2525253A115%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_051612ce-6c04-407a-bac9-523b04f4e0f1_d93278f6-9623-4389-bdfa-4dc1836e9797-column-maxLatency2%25255Ehidden%25253Db%2525253A0%25255Ewidth%25253Dn%2525253A109%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_051612ce-6c04-407a-bac9-523b04f4e0f1_d93278f6-9623-4389-bdfa-4dc1836e9797-column-txQLatAvg3%25255Ehidden%25253Db%2525253A0%25255Ewidth%25253Dn%2525253A136%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_051612ce-6c04-407a-bac9-523b04f4e0f1_d93278f6-9623-4389-bdfa-4dc1836e9797-column-txQLatMax4%25255Ehidden%25253Db%2525253A0%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_051612ce-6c04-407a-bac9-523b04f4e0f1_d93278f6-9623-4389-bdfa-4dc1836e9797-column-txSbSpaceMin5%25255Ehidden%25253Db%2525253A0%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_051612ce-6c04-407a-bac9-523b04f4e0f1_d93278f6-9623-4389-bdfa-4dc1836e9797-column-rxSbSpaceMin6%25255Ehidden%25253Db%2525253A0%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_051612ce-6c04-407a-bac9-523b04f4e0f1_d93278f6-9623-4389-bdfa-4dc1836e9797-column-kaReset7%25255Ehidden%25253Db%2525253A0%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_051612ce-6c04-407a-bac9-523b04f4e0f1_d93278f6-9623-4389-bdfa-4dc1836e9797-column-numReadyDelay8%25255Ehidden%25253Db%2525253A0",
