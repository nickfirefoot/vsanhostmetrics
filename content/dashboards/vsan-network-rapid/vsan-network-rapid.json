 "dashboards": [
  {
   "id": "1f7894ac-ab74-4751-af11-c7efb5624f3a",
   "name": "vSAN Network Rapid",
   "description": "Grey-state detection for vSAN networking. Non-zero is the catch.",
   "shared": true,
   "hidden": false,
   "creationTime": 0,
   "autoswitchEnabled": false,
   "importAttempts": 0,
   "columnProportion": "1",
