       "value": "o%3Acolumns%3Da%253Ao%25253Aid%25253Ds%2525253ApermTableView_widget_620b297d-475f-4199-bdd2-8383b6bed398_ffdbbbe8-02da-4df5-9005-7182781b09cb-column-0%25255Ehidden%25253Db%2525253A0%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_620b297d-475f-4199-bdd2-8383b6bed398_ffdbbbe8-02da-4df5-9005-7182781b09cb-column-avgLatency1%25255Ehidden%25253Db%2525253A0%25255Ewidth%25253Dn%2525253A115%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_620b297d-475f-4199-bdd2-8383b6bed398_ffdbbbe8-02da-4df5-9005-7182781b09cb-column-maxLatency2%25255Ehidden%25253Db%2525253A0%25255Ewidth%25253Dn%2525253A109%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_620b297d-475f-4199-bdd2-8383b6bed398_ffdbbbe8-02da-4df5-9005-7182781b09cb-column-txQLatAvg3%25255Ehidden%25253Db%2525253A0%25255Ewidth%25253Dn%2525253A136%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_620b297d-475f-4199-bdd2-8383b6bed398_ffdbbbe8-02da-4df5-9005-7182781b09cb-column-txQLatMax4%25255Ehidden%25253Db%2525253A0%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_620b297d-475f-4199-bdd2-8383b6bed398_ffdbbbe8-02da-4df5-9005-7182781b09cb-column-txSbSpaceMin5%25255Ehidden%25253Db%2525253A0%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_620b297d-475f-4199-bdd2-8383b6bed398_ffdbbbe8-02da-4df5-9005-7182781b09cb-column-rxSbSpaceMin6%25255Ehidden%25253Db%2525253A0%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_620b297d-475f-4199-bdd2-8383b6bed398_ffdbbbe8-02da-4df5-9005-7182781b09cb-column-kaReset7%25255Ehidden%25253Db%2525253A0%255Eo%25253Aid%25253Ds%2525253ApermTableView_widget_620b297d-475f-4199-bdd2-8383b6bed398_ffdbbbe8-02da-4df5-9005-7182781b09cb-column-numReadyDelay8%25255Ehidden%25253Db%2525253A0",
